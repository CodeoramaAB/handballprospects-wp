msgstr ""
"Project-Id-Version: HandballProspects – Följ spelarna\n"
"Language: sv_SE\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: handballprospects\n"

msgid "Follow the players – HandballProspects"
msgstr "Följ spelarna – HandballProspects"

msgid "Search player"
msgstr "Sök spelare"

msgid "Search player by name…"
msgstr "Sök spelare på namn…"

msgid "Shown as small cards at the end of the article. Each player also gets a tag with their name."
msgstr "Visas som små kort sist i artikeln. Varje spelare får också en tagg med sitt namn."

msgid "Searching…"
msgstr "Söker…"

msgid "No players found."
msgstr "Inga spelare hittades."

msgid "The search failed. Try again."
msgstr "Sökningen misslyckades. Försök igen."

msgid "The article already has the maximum number of players."
msgstr "Artikeln har redan maxantalet spelare."

msgid "Move up"
msgstr "Flytta upp"

msgid "Move down"
msgstr "Flytta ned"

msgid "Remove"
msgstr "Ta bort"

msgid "No players selected."
msgstr "Inga spelare valda."

msgid "HandballProspects is not configured on this site."
msgstr "HandballProspects är inte konfigurerat på den här sajten."

msgid "HandballProspects could not be reached. Try again in a moment."
msgstr "HandballProspects svarar inte. Försök igen om en stund."

msgid "%d yrs"
msgstr "%d år"

msgid "b. %d"
msgstr "f. %d"

msgid "Follow the players"
msgstr "Följ spelarna"

msgid "on HandballProspects"
msgstr "på HandballProspects"

msgid "HandballProspects"
msgstr "HandballProspects"

msgid "Settings"
msgstr "Inställningar"

msgid "Link the players in your articles to their profiles on HandballProspects. The token identifies this site; you get it from HandballProspects."
msgstr "Koppla spelarna i era artiklar till deras profiler på HandballProspects. Token identifierar den här sajten, och ni får den av HandballProspects."

msgid "Token"
msgstr "Token"

msgid "Set in wp-config.php (HANDBALLPROSPECTS_TOKEN), which takes precedence over this page."
msgstr "Satt i wp-config.php (HANDBALLPROSPECTS_TOKEN), som går före den här sidan."

msgid "Paste the token here"
msgstr "Klistra in token här"

msgid "Saved (ends with %s) – leave empty to keep"
msgstr "Sparad (slutar på %s) – lämna tomt för att behålla"

msgid "Remove the saved token"
msgstr "Ta bort den sparade token"

msgid "No token yet: the player box is hidden in the editor until one is saved."
msgstr "Ingen token än: spelarrutan syns inte i editorn förrän en token är sparad."

msgid "Connected: HandballProspects accepts the token."
msgstr "Ansluten: HandballProspects godkänner token."

msgid "HandballProspects does not recognise the token. Check that it was pasted in full."
msgstr "HandballProspects känner inte igen token. Kontrollera att hela token klistrades in."

msgid "HandballProspects could not be reached. The cards show what was known when the players were picked until it answers again."
msgstr "HandballProspects svarar inte. Korten visar det som var känt när spelarna valdes tills HandballProspects svarar igen."

msgid "The player box needs the site's HandballProspects token. Writers do not see it until the token is saved."
msgstr "Spelarrutan behöver sajtens token från HandballProspects. Skribenterna ser den inte förrän token är sparad."

msgid "Add the token"
msgstr "Lägg in token"
